            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.85</airwaySeal><airwaySealed>true</airwaySealed></li></value>
          </li>
      </operations>
    </match>
  </Operation>

  <!-- ============================ FashionRIMsta (Continued) ============================ -->
  <!-- Pure-XML apparel pack. Gasmask (FullHead, ToxicResistance only => no runtime filter => author airway).
       Surgical mask + scrubs = a doctor set; chef jacket = apron-equivalent; chef hat / desert wrap small. -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>Mlie.FashionRIMsta</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
          <!-- Gasmask (FullHead filter; no ToxEnv of its own) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSGasmask" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSGasmask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.7</airwaySeal></li></value>
          </li>
          <!-- Surgical mask -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSSurgicalMask" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSSurgicalMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.55</airwaySeal></li></value>
          </li>
          <!-- Scrubs -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSScrubs" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="Apparel_FSScrubs" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
