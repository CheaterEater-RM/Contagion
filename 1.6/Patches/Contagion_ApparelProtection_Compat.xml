            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.7</airwaySeal><airwaySealed>true</airwaySealed></li></value>
          </li>
          <!-- Siegebreaker armor / helmet (~ vanilla marine; spacer powered, enclosed helmet) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_HeavyMarineArmor" and not(modExtensions)]</xpath><value><modExtensions /></value>
