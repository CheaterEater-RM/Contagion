            <value><li Class="Contagion.ApparelContagionProtection"><handsSeal>0.45</handsSeal></li></value>
          </li>
          <!-- Boots / shoes (surface/contact feet) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[(defName="VAE_Footwear_Boots" or defName="VAE_Footwear_Shoes") and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[(defName="VAE_Footwear_Boots" or defName="VAE_Footwear_Shoes") and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><feetSeal>0.3</feetSeal></li></value>
          </li>
          <!-- Surgical mask (airway filter; covers the head = "airways + contact on head") -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_SurgicalMask" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_SurgicalMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.55</airwaySeal></li></value>
          </li>
          <!-- Doctor scrubs (big body bonus; the doctor set is scrubs + surgical mask) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_DoctorScrubs" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_DoctorScrubs" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.6</skinSeal></li></value>
          </li>
          <!-- Lab coat -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_LabCoat" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_LabCoat" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.45</skinSeal></li></value>
          </li>
          <!-- Chef's uniform (apron-equivalent: good cooking + general body bonus) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_ChefsUniform" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_ChefsUniform" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.5</skinSeal></li></value>
          </li>
          <!-- Chef's toque (small generous cook bonus; airway filter) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_ChefsToque" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_ChefsToque" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.15</airwaySeal></li></value>
          </li>
      </operations>
    </match>
  </Operation>

  <!-- ============================ Vanilla Armour Expanded ============================ -->
  <!-- HAZMAT suit + HAZMAT hood => fully sealed capstone => immune (hood covers Eyes but is described as a
       full-head gas mask). Combat sets mirror vanilla tiers: riot ~ flak (covering-grade, not hermetic),
       trooper ~ recon, siegebreaker ~ marine. Spacer FullHead/VacRes>=0.5 helmets seal the airway (design §3.4). -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>VanillaExpanded.VARME</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
          <!-- HAZMAT suit (dedicated; near-full skin seal) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_HAZMATSuit" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_HAZMATSuit" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.95</skinSeal><coversExtremities>true</coversExtremities><durableSeal>true</durableSeal></li></value>
          </li>
          <!-- HAZMAT hood (hermetic; pairs with suit for full seal) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_HAZMATMask" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_HAZMATMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySealed>true</airwaySealed><durableSeal>true</durableSeal></li></value>
          </li>
          <!-- Gloves: plate (medieval) modest, marine (powered) strong -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><handsSeal>0.4</handsSeal></li></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Handwear_MarineGloves" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Handwear_MarineGloves" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><handsSeal>0.7</handsSeal></li></value>
          </li>
          <!-- Boots: plate modest, marine strong -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Footwear_PlateBoots" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Footwear_PlateBoots" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><feetSeal>0.4</feetSeal></li></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Footwear_MarineBoots" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Footwear_MarineBoots" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><feetSeal>0.7</feetSeal></li></value>
          </li>
          <!-- Riot armor / helmet (~ vanilla flak: covering-grade, not hermetic) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_RiotArmor" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_RiotArmor" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.5</skinSeal></li></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_RiotHelmet" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_RiotHelmet" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.55</airwaySeal></li></value>
          </li>
          <!-- Trooper armor / helmet (~ vanilla recon; spacer powered, helmet seals) -->
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_TrooperArmor" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Apparel_TrooperArmor" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
            <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.85</skinSeal><coversExtremities>true</coversExtremities></li></value>
          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
