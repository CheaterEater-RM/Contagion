          </li>
          <li Class="PatchOperationAdd"><success>Always</success>
            <xpath>Defs/ThingDef[defName="VAE_Headgear_HeavyMarineHelmet" and not(modExtensions)]</xpath><value><modExtensions /></value>
          </li>
