  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Plague" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Plague" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>1.0</incubationDays>
        <pendingWindowDays>5</pendingWindowDays>
        <immunityDurationDays>0</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <!-- Animal_Plague is the animal-variant hediff: same disease cluster, 48h tend cycle instead of 12h. -->
        <animalVariantDef>Animal_Plague</animalVariantDef>
        <crossSpeciesTransmissionFactor>0.5</crossSpeciesTransmissionFactor>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <spreadSuppressionScale>1.0</spreadSuppressionScale>
        <sourceInfectivityFactors>
          <li Class="Contagion.SourceFactor_Trait">
            <trait>Immunity</trait>
            <degree>-1</degree>
            <factor>0.5</factor>
          </li>
        </sourceInfectivityFactors>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.2)</li>
            <li>(0.20, 0.8)</li>
            <li>(0.60, 1.0)</li>
            <li>(0.90, 0.4)</li>
            <li>(1.00, 0.0)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <li Class="Contagion.Vector_Proximity">
            <baseChancePerCheck>0.025</baseChancePerCheck>
            <maxRange>6</maxRange>
            <distanceFalloffRate>0.35</distanceFalloffRate>
            <cleanlinessImpact>1.0</cleanlinessImpact>
            <outdoorFactor>0.75</outdoorFactor>
            <outdoorFilthRadius>4</outdoorFilthRadius>
            <maskTargetEffectiveness>0.4</maskTargetEffectiveness>
            <maskSourceEffectiveness>0.3</maskSourceEffectiveness>
            <!-- Plague spreads by contact/fleas, not the airways, so gene airway immunity (breathless) does not help. -->
            <airwayImmunityFactor>0</airwayImmunityFactor>
          </li>
        </vectors>
        <seeders>
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>15</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_AnimalLinked">
            <mtbDays>120</mtbDays>
            <cooldownDays>15</cooldownDays>
            <requiresAnimalsOnMap>true</requiresAnimalsOnMap>
            <handlerBias>2.0</handlerBias>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.01</arrivalChance>
            <cooldownDays>3</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>15</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>6</maxActiveCases>
      </li>
    </value>
  </Operation>

  <!-- ── Gut Worms ─────────────────────────────────────────────────────────────────── -->
  <!-- Redesigned: enters via contaminated water (environmental) and infected animal meat
       (butchering chain). Spreads within the colony via contaminated food and vomit fomite.
       Animals also carry it, meaning infected animal carcasses are unsafe to butcher. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="GutWorms" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="GutWorms" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>3.0</incubationDays>
        <immunityDurationDays>15</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <!-- Stomach targeting for humans; animals get the generic disease. -->
        <targetBodyParts>
          <li>Stomach</li>
        </targetBodyParts>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.3)</li>
            <li>(0.20, 0.7)</li>
            <li>(0.60, 1.0)</li>
            <li>(1.00, 1.0)</li>
          </points>
        </activeInfectivityCurve>
        <spreadSuppressionScale>0</spreadSuppressionScale>
        <outbreakNotification>None</outbreakNotification>
        <vectors>
          <!-- Primary human exposure: contaminated food (from infected cook or infected meat). -->
          <li Class="Contagion.Vector_Foodborne">
            <baseChancePerMeal>0.08</baseChancePerMeal>
            <cleanlinessImpact>1.0</cleanlinessImpact>
            <contaminationExpiryDays>30</contaminationExpiryDays>
          </li>
          <!-- Secondary spread within colony: vomit fomite (gut worms causes vomiting). -->
          <li Class="Contagion.Vector_Fomite">
            <contaminatesVomit>true</contaminatesVomit>
            <baseChancePerContact>0.025</baseChancePerContact>
            <potencyDecayPerHour>0.08</potencyDecayPerHour>
            <activeInfectivityCurveOverride>
              <points>
                <li>(0.50, 0.0)</li>
                <li>(0.65, 0.5)</li>
                <li>(0.80, 1.0)</li>
                <li>(1.00, 0.8)</li>
              </points>
            </activeInfectivityCurveOverride>
          </li>
          <!-- Animal acquisition: contaminated water. Worm eggs survive near-freezing water,
               peak in moderate warmth. Outdoor animals are fully exposed; indoor ones are not. -->
          <li Class="Contagion.Vector_Environmental">
            <baseChancePerCheck>0.002</baseChancePerCheck>
            <minTemperature>-10</minTemperature>
            <peakTemperature>22</peakTemperature>
            <waterProximityRadius>14</waterProximityRadius>
            <waterProximityWeight>0.08</waterProximityWeight>
            <indoorReductionPerCellFromEdge>0.15</indoorReductionPerCellFromEdge>
            <coolRoomThreshold>10</coolRoomThreshold>
          </li>
        </vectors>
        <seeders>
          <!-- Seeder_Storyteller makes selfSchedules (or the existing vanilla incident) the Mode 1
               trigger; paired with Seeder_Environmental it opens an environmental window rather than
               seeding a carrier directly (see UsesEnvironmentalSeedingOnly). -->
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>20</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Environmental">
            <baseChanceMultiplier>0.8</baseChanceMultiplier>
            <windowDays>14</windowDays>
            <infectionBudget>2~4</infectionBudget>
            <cooldownDays>10</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>20</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>3</maxActiveCases>
      </li>
    </value>
  </Operation>

  <!-- ── Muscle Parasites ───────────────────────────────────────────────────────────── -->
  <!-- Vanilla Core hediff (Disease_MuscleParasites incident also exists — no selfSchedules needed).
       Trichinella-type larvae contracted by eating raw or improperly cooked meat from infected
       animals. No person-to-person spread and no vomiting — the chain is:
       environment → animal → butchered meat → human exclusively. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="MuscleParasites" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="MuscleParasites" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>5.0</incubationDays>
        <immunityDurationDays>20</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <spreadSuppressionScale>0</spreadSuppressionScale>
        <outbreakNotification>FirstCase</outbreakNotification>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.2)</li>
            <li>(0.30, 0.6)</li>
            <li>(0.70, 1.0)</li>
            <li>(1.00, 0.8)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <!-- Primary human exposure: contaminated meat (raw or undercooked). -->
          <li Class="Contagion.Vector_Foodborne">
            <baseChancePerMeal>0.10</baseChancePerMeal>
            <cleanlinessImpact>0.5</cleanlinessImpact>
            <contaminationExpiryDays>45</contaminationExpiryDays>
          </li>
          <!-- Animal acquisition: outdoor soil contamination from parasite eggs in faeces.
               Lower water dependency than gut worms; broader temperature tolerance.
               Heavy indoor reduction: only grazing/outdoor animals pick it up. -->
          <li Class="Contagion.Vector_Environmental">
            <baseChancePerCheck>0.0015</baseChancePerCheck>
            <minTemperature>-15</minTemperature>
            <peakTemperature>18</peakTemperature>
            <waterProximityRadius>6</waterProximityRadius>
            <waterProximityWeight>0.02</waterProximityWeight>
            <indoorReductionPerCellFromEdge>0.20</indoorReductionPerCellFromEdge>
            <coolRoomThreshold>8</coolRoomThreshold>
          </li>
        </vectors>
        <seeders>
          <!-- Seeder_Storyteller pairs with Seeder_Environmental: the vanilla Disease_MuscleParasites
               incident fires → environmental window opens → outdoor animals get exposed. -->
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>30</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Environmental">
            <baseChanceMultiplier>0.7</baseChanceMultiplier>
            <windowDays>14</windowDays>
            <infectionBudget>1~3</infectionBudget>
            <cooldownDays>15</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>300</mtbDays>
            <cooldownDays>30</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>4</maxActiveCases>
      </li>
    </value>
  </Operation>

