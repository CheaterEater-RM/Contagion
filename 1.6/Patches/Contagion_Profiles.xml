<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Flu" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Flu" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>1.5</incubationDays>
        <pendingWindowDays>15</pendingWindowDays>
        <immunityDurationDays>0</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <incubationInfectivityCurve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.3, 0.15)</li>
            <li>(0.7, 0.45)</li>
            <li>(1.0, 0.5)</li>
          </points>
        </incubationInfectivityCurve>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.5)</li>
            <li>(0.25, 1.0)</li>
            <li>(0.55, 1.0)</li>
            <li>(0.80, 0.3)</li>
            <li>(1.00, 0.0)</li>
          </points>
        </activeInfectivityCurve>
        <seasonalInfectivity>
          <spring>0.6</spring>
          <summer>0.3</summer>
          <fall>0.8</fall>
          <winter>1.0</winter>
          <permanentSummer>0.4</permanentSummer>
          <permanentWinter>0.7</permanentWinter>
        </seasonalInfectivity>
        <spreadSuppressionScale>1.0</spreadSuppressionScale>
        <!-- Sickly pawns shed less: vanilla amplifies their disease rate (randomDiseaseMtbDays),
             so reducing outward spread keeps them from becoming a constant colony outbreak source.
             Note: the Sickly trait is defined as TraitDef "Immunity" degree -1 in vanilla —
             this entry targets Sickly, not the Tough/Robust immunity trait. -->
        <sourceInfectivityFactors>
          <li Class="Contagion.SourceFactor_Trait">
            <!-- "Immunity" degree -1 = vanilla Sickly trait (not the Robust/Tough trait). -->
            <trait>Immunity</trait>
            <degree>-1</degree>
            <factor>0.5</factor>
          </li>
        </sourceInfectivityFactors>
        <vectors>
          <li Class="Contagion.Vector_Airborne">
            <baseChancePerCheck>0.03</baseChancePerCheck>
            <outdoorFactor>0.15</outdoorFactor>
            <maxRange>15</maxRange>
            <distanceFalloffRate>0.25</distanceFalloffRate>
            <obstructedFactor>0.0</obstructedFactor>
            <maskTargetEffectiveness>0.7</maskTargetEffectiveness>
            <maskSourceEffectiveness>0.5</maskSourceEffectiveness>
          </li>
          <li Class="Contagion.Vector_Social">
            <baseChancePerInteraction>0.02</baseChancePerInteraction>
            <outdoorFactor>0.5</outdoorFactor>
            <maskTargetEffectiveness>0.6</maskTargetEffectiveness>
            <maskSourceEffectiveness>0.5</maskSourceEffectiveness>
          </li>
          <li Class="Contagion.Vector_Fomite">
            <contaminatesVomit>true</contaminatesVomit>
            <baseChancePerContact>0.03</baseChancePerContact>
            <potencyDecayPerHour>0.1</potencyDecayPerHour>
            <activeInfectivityCurveOverride>
              <points>
                <li>(0.50, 0.0)</li>
                <li>(0.65, 0.5)</li>
                <li>(0.80, 1.0)</li>
                <li>(1.00, 0.5)</li>
              </points>
            </activeInfectivityCurveOverride>
          </li>
        </vectors>
        <seeders>
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>10</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.01</arrivalChance>
            <cooldownDays>3</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>10</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>5</maxActiveCases>
        <outbreakNotification>FirstCase</outbreakNotification>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Animal_Flu" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
