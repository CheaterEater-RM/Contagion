        <pendingWindowDays>15</pendingWindowDays>
        <immunityDurationDays>0</immunityDurationDays>
        <affectsHumans>false</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <!-- Species-specific barrier: flu spreads freely within a species but jumps between
             animal species at only ~10% efficiency — avian flu analogy. A sick chicken won't
             reliably infect a pig in the same barn, though rare cross-species jumps still occur. -->
        <animalCrossSpeciesFactor>0.10</animalCrossSpeciesFactor>
        <incubationInfectivityCurve>
          <points>
            <li>(0.0, 0.0)</li>
            <li>(0.3, 0.15)</li>
            <li>(0.7, 0.45)</li>
            <li>(1.0, 0.5)</li>
          </points>
        </incubationInfectivityCurve>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.5)</li>
            <li>(0.25, 1.0)</li>
            <li>(0.55, 1.0)</li>
            <li>(0.80, 0.3)</li>
            <li>(1.00, 0.0)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <li Class="Contagion.Vector_Airborne">
            <baseChancePerCheck>0.03</baseChancePerCheck>
            <outdoorFactor>0.15</outdoorFactor>
            <maxRange>15</maxRange>
            <distanceFalloffRate>0.25</distanceFalloffRate>
            <obstructedFactor>0.0</obstructedFactor>
          </li>
          <li Class="Contagion.Vector_Fomite">
            <contaminatesVomit>true</contaminatesVomit>
            <baseChancePerContact>0.03</baseChancePerContact>
            <potencyDecayPerHour>0.1</potencyDecayPerHour>
          </li>
        </vectors>
        <seeders>
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>10</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.01</arrivalChance>
            <cooldownDays>3</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>10</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>5</maxActiveCases>
      </li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Plague" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Plague" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>2.5</incubationDays>
        <pendingWindowDays>5</pendingWindowDays>
        <immunityDurationDays>0</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <!-- Animal_Plague is the animal-variant hediff: same disease cluster, 48h tend cycle instead of 12h. -->
        <animalVariantDef>Animal_Plague</animalVariantDef>
        <crossSpeciesTransmissionFactor>0.5</crossSpeciesTransmissionFactor>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <!-- Passive presentation uses the default curve (~25% cumulative). Posthumous at 10% —
             plague lesions are apparent on a corpse even without prior symptoms. -->
        <posthumousSymptomChance>0.1</posthumousSymptomChance>
        <spreadSuppressionScale>1.0</spreadSuppressionScale>
        <sourceInfectivityFactors>
          <li Class="Contagion.SourceFactor_Trait">
            <!-- "Immunity" degree -1 = vanilla Sickly trait (not the Robust/Tough trait). -->
            <trait>Immunity</trait>
            <degree>-1</degree>
            <factor>0.5</factor>
          </li>
        </sourceInfectivityFactors>
        <!-- Fleas on an incubating host jump to nearby pawns regardless of symptom stage.
             Infectivity is flat-and-meaningful from day 1, unlike flu which ramps up only near symptom onset. -->
        <incubationInfectivityCurve>
          <points>
            <li>(0.0, 0.3)</li>
            <li>(0.5, 0.45)</li>
            <li>(1.0, 0.6)</li>
          </points>
        </incubationInfectivityCurve>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.2)</li>
            <li>(0.20, 0.8)</li>
            <li>(0.60, 1.0)</li>
            <li>(0.90, 0.4)</li>
            <li>(1.00, 0.0)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <!-- Fresh plague corpses shed fleas after a short post-death ramp. Freezing kills
               this vector quickly; otherwise the flea burst fades within a couple of days. -->
          <li Class="Contagion.Vector_CorpseFlea">
            <baseChancePerCheck>0.006</baseChancePerCheck>
            <carriedBaseChancePerCheck>0.025</carriedBaseChancePerCheck>
            <butcherBaseChance>0.600</butcherBaseChance>
            <maxRange>12</maxRange>
            <carriedRange>4</carriedRange>
            <distanceFalloffRate>0.25</distanceFalloffRate>
            <frozenTemperature>0</frozenTemperature>
            <frozenViabilityLossPerDay>4.0</frozenViabilityLossPerDay>
            <corpseAgePotencyCurve>
              <points>
                <li>(0.00, 0.10)</li>
                <li>(0.08, 0.40)</li>
                <li>(0.25, 2.50)</li>
                <li>(0.75, 1.50)</li>
                <li>(1.50, 0.25)</li>
                <li>(2.00, 0.00)</li>
              </points>
            </corpseAgePotencyCurve>
          </li>
          <!-- Corpse fluids start low, then grow more dangerous as the body breaks down.
               Dessicated corpses no longer expose handlers through this vector. -->
          <li Class="Contagion.Vector_CorpseFluid">
            <pickupChance>0.015</pickupChance>
            <putdownChance>0.015</putdownChance>
            <carriedChancePerCheck>0.003</carriedChancePerCheck>
            <butcherChance>1.000</butcherChance>
            <corpseAgePotencyCurve>
              <points>
                <li>(0.00, 0.10)</li>
                <li>(0.15, 0.20)</li>
                <li>(0.50, 0.45)</li>
                <li>(1.50, 0.90)</li>
                <li>(3.00, 1.30)</li>
                <li>(7.00, 1.50)</li>
                <li>(12.00, 0.00)</li>
              </points>
            </corpseAgePotencyCurve>
          </li>
          <li Class="Contagion.Vector_Foodborne">
            <baseChancePerMeal>0.25</baseChancePerMeal>
            <cleanlinessImpact>0.5</cleanlinessImpact>
            <contaminationExpiryDays>15</contaminationExpiryDays>
          </li>
          <li Class="Contagion.Vector_CookingExposure">
            <baseChancePerRecipe>0.004</baseChancePerRecipe>
            <lowSkillFactor>2.0</lowSkillFactor>
            <highSkillFactor>0.5</highSkillFactor>
          </li>
          <li Class="Contagion.Vector_Proximity">
            <baseChancePerCheck>0.025</baseChancePerCheck>
            <maxRange>6</maxRange>
            <distanceFalloffRate>0.35</distanceFalloffRate>
            <cleanlinessImpact>1.0</cleanlinessImpact>
            <outdoorFactor>0.75</outdoorFactor>
            <outdoorFilthRadius>4</outdoorFilthRadius>
            <maskTargetEffectiveness>0.4</maskTargetEffectiveness>
            <maskSourceEffectiveness>0.3</maskSourceEffectiveness>
            <!-- Plague spreads by contact/fleas, not the airways, so gene airway immunity (breathless) does not help. -->
            <airwayImmunityFactor>0</airwayImmunityFactor>
          </li>
        </vectors>
        <seeders>
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>15</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.01</arrivalChance>
            <cooldownDays>3</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>15</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>6</maxActiveCases>
      </li>
    </value>
  </Operation>

  <!-- ── Gut Worms ─────────────────────────────────────────────────────────────────── -->
  <!-- Redesigned: enters via contaminated water (environmental) and infected animal meat
       (butchering chain). Spreads within the colony via contaminated food and vomit fomite.
       Animals also carry it, meaning infected animal carcasses are unsafe to butcher. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="GutWorms" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="GutWorms" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>3.0</incubationDays>
        <immunityDurationDays>15</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <!-- Animal_GutWorms is the animal-variant hediff: same disease cluster, hidden until diagnosed. -->
        <animalVariantDef>Animal_GutWorms</animalVariantDef>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <!-- Gut worms are not externally visible — reduced passive presentation (~10% cumulative)
             and a lower posthumous chance (5%: worms are internal and not obvious post-mortem). -->
        <passiveSymptomPresentationCurve>
          <points>
            <li>(0.0, 0.00)</li>
            <li>(0.3, 0.003)</li>
            <li>(0.7, 0.007)</li>
            <li>(1.0, 0.012)</li>
          </points>
        </passiveSymptomPresentationCurve>
        <posthumousSymptomChance>0.05</posthumousSymptomChance>
        <!-- Stomach targeting for humans; animals skip part targeting entirely. -->
        <targetBodyParts>
          <li>Stomach</li>
        </targetBodyParts>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.3)</li>
            <li>(0.20, 0.7)</li>
            <li>(0.60, 1.0)</li>
            <li>(1.00, 1.0)</li>
          </points>
        </activeInfectivityCurve>
        <spreadSuppressionScale>0</spreadSuppressionScale>
        <outbreakNotification>None</outbreakNotification>
        <vectors>
          <!-- Primary human exposure: contaminated food (from infected cook or infected meat). -->
          <li Class="Contagion.Vector_Foodborne">
            <baseChancePerMeal>0.80</baseChancePerMeal>
            <cleanlinessImpact>1.0</cleanlinessImpact>
            <contaminationExpiryDays>30</contaminationExpiryDays>
          </li>
          <!-- Very low parasite exposure while cutting open an infected carcass. Normal hauling is
               still safe; gut worms mainly matter through contaminated food and vomit. -->
          <li Class="Contagion.Vector_CorpseFluid">
            <pickupChance>0</pickupChance>
            <putdownChance>0</putdownChance>
            <carriedChancePerCheck>0</carriedChancePerCheck>
            <butcherChance>0.006</butcherChance>
            <corpseAgePotencyCurve>
              <points>
                <li>(0.00, 0.05)</li>
                <li>(0.50, 0.15)</li>
                <li>(2.00, 0.35)</li>
                <li>(5.00, 0.50)</li>
                <li>(12.00, 0.00)</li>
              </points>
            </corpseAgePotencyCurve>
          </li>
          <li Class="Contagion.Vector_CookingExposure">
            <baseChancePerRecipe>0.003</baseChancePerRecipe>
            <lowSkillFactor>2.0</lowSkillFactor>
            <highSkillFactor>0.5</highSkillFactor>
          </li>
          <!-- Secondary spread within colony: vomit fomite (gut worms causes vomiting). -->
          <li Class="Contagion.Vector_Fomite">
            <contaminatesVomit>true</contaminatesVomit>
            <baseChancePerContact>0.025</baseChancePerContact>
            <potencyDecayPerHour>0.08</potencyDecayPerHour>
            <activeInfectivityCurveOverride>
              <points>
                <li>(0.50, 0.0)</li>
                <li>(0.65, 0.5)</li>
                <li>(0.80, 1.0)</li>
                <li>(1.00, 0.8)</li>
              </points>
            </activeInfectivityCurveOverride>
          </li>
          <!-- Environmental acquisition: contaminated water. Worm eggs require above-freezing water to
               remain viable — minTemperature 0 reflects that frozen/icy water suppresses transmission.
               Peak in moderate warmth. Outdoor animals are fully exposed; indoor ones are not.
               Humans can catch it too, but hygiene lowers their ambient exposure. -->
          <li Class="Contagion.Vector_Environmental">
            <baseChancePerCheck>0.002</baseChancePerCheck>
            <humanExposureFactor>0.50</humanExposureFactor>
            <minTemperature>0</minTemperature>
            <peakTemperature>22</peakTemperature>
            <waterProximityRadius>14</waterProximityRadius>
            <waterProximityWeight>0.08</waterProximityWeight>
            <indoorReductionPerCellFromEdge>0.15</indoorReductionPerCellFromEdge>
            <coolRoomThreshold>10</coolRoomThreshold>
          </li>
        </vectors>
        <seeders>
          <!-- Seeder_Storyteller makes selfSchedules (or the existing vanilla incident) the Mode 1
               trigger; paired with Seeder_Environmental it opens an environmental window rather than
               seeding a carrier directly. Seeder_Arrival is used by Contagion-driven mode. -->
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>20</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Environmental">
            <baseChanceMultiplier>0.8</baseChanceMultiplier>
            <windowDays>14</windowDays>
            <infectionBudget>2~4</infectionBudget>
            <cooldownDays>3</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.006</arrivalChance>
            <cooldownDays>5</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>180</mtbDays>
            <cooldownDays>20</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>3</maxActiveCases>
      </li>
    </value>
  </Operation>

  <!-- ── Muscle Parasites ───────────────────────────────────────────────────────────── -->
  <!-- Vanilla Core hediff (Disease_MuscleParasites incident also exists — no selfSchedules needed).
       Trichinella-type larvae contracted by eating raw or improperly cooked meat from infected
       animals. No person-to-person spread and no vomiting — the main chain is:
       environment → animal → butchered meat → human, with direct outdoor environmental exposure also possible. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="MuscleParasites" and not(modExtensions)]</xpath>
    <value>
      <modExtensions />
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="MuscleParasites" and not(modExtensions/li[@Class="Contagion.TransmissionProfile"])]/modExtensions</xpath>
    <value>
      <li Class="Contagion.TransmissionProfile">
        <incubationDays>5.0</incubationDays>
        <immunityDurationDays>20</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <affectsAnimals>true</affectsAnimals>
        <!-- Animal_MuscleParasites is the animal-variant hediff: same disease cluster, hidden until diagnosed. -->
        <animalVariantDef>Animal_MuscleParasites</animalVariantDef>
        <corpseContagious>true</corpseContagious>
        <showsSickSignal>true</showsSickSignal>
        <!-- Muscle parasites are deeply embedded — reduced passive presentation (~10% cumulative)
             and a low posthumous chance (5%: larvae not externally visible without dissection). -->
        <passiveSymptomPresentationCurve>
          <points>
            <li>(0.0, 0.00)</li>
            <li>(0.3, 0.003)</li>
            <li>(0.7, 0.007)</li>
            <li>(1.0, 0.012)</li>
          </points>
        </passiveSymptomPresentationCurve>
        <posthumousSymptomChance>0.05</posthumousSymptomChance>
        <spreadSuppressionScale>0</spreadSuppressionScale>
        <outbreakNotification>FirstCase</outbreakNotification>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.2)</li>
            <li>(0.30, 0.6)</li>
            <li>(0.70, 1.0)</li>
            <li>(1.00, 0.8)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <!-- Primary human exposure: contaminated meat (raw or undercooked). -->
          <li Class="Contagion.Vector_Foodborne">
            <baseChancePerMeal>0.85</baseChancePerMeal>
            <cleanlinessImpact>0.5</cleanlinessImpact>
            <contaminationExpiryDays>45</contaminationExpiryDays>
          </li>
          <!-- Low direct butchery exposure: larvae are mainly a meat-ingestion problem, but
               cutting infected tissue is not perfectly safe. -->
          <li Class="Contagion.Vector_CorpseFluid">
            <pickupChance>0</pickupChance>
            <putdownChance>0</putdownChance>
            <carriedChancePerCheck>0</carriedChancePerCheck>
            <butcherChance>0.008</butcherChance>
            <corpseAgePotencyCurve>
              <points>
                <li>(0.00, 0.10)</li>
                <li>(0.50, 0.15)</li>
                <li>(2.00, 0.25)</li>
                <li>(7.00, 0.40)</li>
                <li>(12.00, 0.00)</li>
              </points>
            </corpseAgePotencyCurve>
          </li>
          <li Class="Contagion.Vector_CookingExposure">
            <baseChancePerRecipe>0.004</baseChancePerRecipe>
            <lowSkillFactor>2.0</lowSkillFactor>
            <highSkillFactor>0.5</highSkillFactor>
          </li>
          <!-- Environmental acquisition: outdoor soil contamination from parasite eggs in faeces.
               Lower water dependency than gut worms. Eggs tolerate mild cold but die in
               sustained arctic conditions — minTemperature -5 reflects borderline survivability
               below freezing without permitting true arctic transmission.
               Heavy indoor reduction: grazing/outdoor animals are most exposed. Humans can catch
               it too, but hygiene lowers their ambient exposure. -->
          <li Class="Contagion.Vector_Environmental">
            <baseChancePerCheck>0.0015</baseChancePerCheck>
            <humanExposureFactor>0.45</humanExposureFactor>
            <minTemperature>-5</minTemperature>
            <peakTemperature>18</peakTemperature>
            <waterProximityRadius>6</waterProximityRadius>
            <waterProximityWeight>0.02</waterProximityWeight>
            <indoorReductionPerCellFromEdge>0.20</indoorReductionPerCellFromEdge>
            <coolRoomThreshold>8</coolRoomThreshold>
          </li>
        </vectors>
        <seeders>
          <!-- Seeder_Storyteller pairs with Seeder_Environmental: the vanilla Disease_MuscleParasites
               incident fires → environmental window opens. Seeder_Arrival is used by Contagion-driven mode. -->
          <li Class="Contagion.Seeder_Storyteller">
            <seedCountRange>1~1</seedCountRange>
            <cooldownDays>30</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Environmental">
            <baseChanceMultiplier>0.7</baseChanceMultiplier>
            <windowDays>14</windowDays>
            <infectionBudget>1~3</infectionBudget>
            <cooldownDays>4</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Arrival">
            <arrivalChance>0.004</arrivalChance>
            <cooldownDays>6</cooldownDays>
          </li>
          <li Class="Contagion.Seeder_Acausal">
            <mtbDays>300</mtbDays>
            <cooldownDays>30</cooldownDays>
          </li>
        </seeders>
        <maxActiveCases>4</maxActiveCases>
      </li>
    </value>
