<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Update the Sickly trait description so the player knows, before picking it at scenario
       design, that under Contagion this pawn may spread the diseases they catch. -->
  <Operation Class="PatchOperationReplace">
    <success>Normal</success>
    <xpath>Defs/TraitDef[defName="Immunity"]/degreeDatas/li[degree="-1"]/description</xpath>
    <value>
      <description>NAME has an awful immune system. S/He gets sick more often, can catch new illnesses without an existing outbreak, and can spread them.</description>
    </value>
  </Operation>

</Patch>
