<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Update the Sickly trait description so the player knows, before picking it at scenario
       design, that under Contagion this pawn may spread the diseases they catch. -->
  <Operation Class="PatchOperationReplace">
    <success>Normal</success>
    <xpath>Defs/TraitDef[defName="Sickly"]/degreeDatas/li/description</xpath>
    <value>
      <description>NAME has an awful immune system. S/He gets sick more often than usual, frequently with illnesses that nobody in the colony has been afflicted by, and can spread them.</description>
    </value>
  </Operation>

</Patch>
