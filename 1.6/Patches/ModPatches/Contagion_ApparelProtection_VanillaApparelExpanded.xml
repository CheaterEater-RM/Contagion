<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Apparel Expanded: soft PPE tuning for gloves, footwear, medical apparel, and cook apparel. -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>VanillaExpanded.VAPPE</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Handwear_Gloves" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><handsSeal>0.45</handsSeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[(defName="VAE_Footwear_Boots" or defName="VAE_Footwear_Shoes") and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[(defName="VAE_Footwear_Boots" or defName="VAE_Footwear_Shoes") and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><feetSeal>0.3</feetSeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_SurgicalMask" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_SurgicalMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.55</airwaySeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_DoctorScrubs" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_DoctorScrubs" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.6</skinSeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_LabCoat" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_LabCoat" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.45</skinSeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_ChefsUniform" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_ChefsUniform" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.5</skinSeal></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_ChefsToque" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_ChefsToque" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.15</airwaySeal></li></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
