      <li Class="Contagion.TransmissionProfile">
        <incubationDays>5.0</incubationDays>
        <pendingWindowDays>30</pendingWindowDays>
        <immunityDurationDays>90</immunityDurationDays>
        <affectsHumans>true</affectsHumans>
        <dangerWeight>1.5</dangerWeight>
        <incubationInfectivityCurve>
          <points>
            <li>(0.0, 0.05)</li>
            <li>(0.5, 0.15)</li>
            <li>(1.0, 0.25)</li>
          </points>
        </incubationInfectivityCurve>
        <activeInfectivityCurve>
          <points>
            <li>(0.00, 0.35)</li>
            <li>(0.20, 0.60)</li>
            <li>(0.70, 0.75)</li>
            <li>(0.95, 0.45)</li>
            <li>(1.00, 0.0)</li>
          </points>
        </activeInfectivityCurve>
        <vectors>
          <li Class="Contagion.Vector_Airborne">
            <baseChancePerCheck>0.006</baseChancePerCheck>
            <outdoorFactor>0.25</outdoorFactor>
            <maxRange>12</maxRange>
            <distanceFalloffRate>0.18</distanceFalloffRate>
            <obstructedFactor>0.0</obstructedFactor>
            <roomAirBaseChanceFactor>0.45</roomAirBaseChanceFactor>
            <roomAirMaxRange>12</roomAirMaxRange>
            <roomAirMaxCells>120</roomAirMaxCells>
            <maskTargetEffectiveness>0.7</maskTargetEffectiveness>
            <maskSourceEffectiveness>0.5</maskSourceEffectiveness>
