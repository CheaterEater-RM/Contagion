<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- FashionRIMsta: pure XML apparel. Gasmask has ToxicResistance only, so author airway protection.
       Surgical mask + scrubs form a doctor set; chef jacket is apron-equivalent; chef hat and wrap are light.
       PatchOperationAddModExtension coexists with any modExtension the source mod adds; the li-guard keeps
       it idempotent. -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSGasmask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.7</airwaySeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSSurgicalMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.55</airwaySeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSScrubs" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.55</skinSeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSChefJacket" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.5</skinSeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSChefsHat" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.15</airwaySeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Mlie.FashionRIMsta"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_FSDesertWrap" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.3</airwaySeal></li></value>
  </Operation>
</Patch>
