<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VFE Medieval 2: the plague mask already grants hard Plague immunity through its own VEF worn hediff.
       Add graded airway protection for other airborne diseases. PatchOperationAddModExtension coexists with
       any modExtension the source mod adds; the li-guard keeps it idempotent. -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="OskarPotocki.VFE.Medieval2"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlagueMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <airwaySeal>0.55</airwaySeal>
            </li>
          </value>
  </Operation>
</Patch>
