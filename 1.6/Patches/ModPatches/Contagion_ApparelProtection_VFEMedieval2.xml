<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- VFE Medieval 2: the plague mask already grants hard Plague immunity through its own VEF worn hediff.
       Add graded airway protection for other airborne diseases. -->
  <Operation Class="PatchOperationAdd" MayRequire="OskarPotocki.VFE.Medieval2"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlagueMask" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
  </Operation>
  <Operation Class="PatchOperationAdd" MayRequire="OskarPotocki.VFE.Medieval2"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VFEM2_Apparel_PlagueMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <airwaySeal>0.55</airwaySeal>
            </li>
          </value>
  </Operation>
</Patch>
