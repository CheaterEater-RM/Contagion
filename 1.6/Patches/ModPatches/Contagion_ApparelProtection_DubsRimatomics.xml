<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Dubs Rimatomics: MOPP gear is sealed CBRN; radiation suit is partial skin protection.
       Radiation/MOPP gear inherits ToxicEnvironmentResistance 0.40, so the radiation mask already filters
       the airway at runtime. MOPP mask uses airwaySealed, with the filter harmless underneath.
       PatchOperationAddModExtension coexists with any modExtension the source mod adds; the li-guard keeps
       it idempotent. -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="Dubwise.Rimatomics"><success>Always</success>
          <xpath>Defs/ThingDef[(defName="Apparel_MoppSuitDesert" or defName="Apparel_MoppSuitWoodland" or defName="Apparel_MoppSuitSnow") and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <skinSeal>0.95</skinSeal>
              <coversExtremities>true</coversExtremities>
              <durableSeal>true</durableSeal>
            </li>
          </value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Dubwise.Rimatomics"><success>Always</success>
          <xpath>Defs/ThingDef[(defName="Apparel_MoppMaskDesert" or defName="Apparel_MoppMaskWoodland" or defName="Apparel_MoppMaskSnow") and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <airwaySealed>true</airwaySealed>
              <durableSeal>true</durableSeal>
            </li>
          </value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="Dubwise.Rimatomics"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_RadiationSuit" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <skinSeal>0.6</skinSeal>
            </li>
          </value>
  </Operation>
</Patch>
