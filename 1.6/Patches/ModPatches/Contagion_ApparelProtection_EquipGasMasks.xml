<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Equip Gas Masks: its mask carries ToxicResistance, not ToxicEnvironmentResistance, so Contagion's
       runtime mask filter sees nothing. Author a graded airway filter without marking it hermetic.
       PatchOperationAddModExtension coexists with any modExtension the source mod adds; the li-guard
       keeps it idempotent. -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="syila.eqgasmask"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_GasMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <airwaySeal>0.8</airwaySeal>
            </li>
          </value>
  </Operation>
</Patch>
