<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Equip Gas Masks: its mask carries ToxicResistance, not ToxicEnvironmentResistance, so Contagion's
       runtime mask filter sees nothing. Author a graded airway filter without marking it hermetic. -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>syila.eqgasmask</li></mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_GasMask" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="Apparel_GasMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value>
            <li Class="Contagion.ApparelContagionProtection">
              <airwaySeal>0.8</airwaySeal>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
