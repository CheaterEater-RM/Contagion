          <xpath>Defs/ThingDef[defName="VAE_Apparel_TrooperArmor" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.85</skinSeal><coversExtremities>true</coversExtremities></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_TrooperHelmet" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_TrooperHelmet" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.7</airwaySeal><airwaySealed>true</airwaySealed></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_HeavyMarineArmor" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_HeavyMarineArmor" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.95</skinSeal><coversExtremities>true</coversExtremities></li></value>
        </li>

        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_HeavyMarineHelmet" and not(modExtensions)]</xpath>
          <value><modExtensions /></value>
        </li>
        <li Class="PatchOperationAdd"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_HeavyMarineHelmet" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]/modExtensions</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySeal>0.85</airwaySeal><airwaySealed>true</airwaySealed></li></value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
