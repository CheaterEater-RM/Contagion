<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Vanilla Armour Expanded: HAZMAT is dedicated PPE; combat sets mirror vanilla armour tiers.
       PatchOperationAddModExtension coexists with any modExtension the source mod adds; the li-guard keeps
       it idempotent. -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="VanillaExpanded.VARME"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Apparel_HAZMATSuit" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><skinSeal>0.95</skinSeal><coversExtremities>true</coversExtremities><durableSeal>true</durableSeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="VanillaExpanded.VARME"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Headgear_HAZMATMask" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><airwaySealed>true</airwaySealed><durableSeal>true</durableSeal></li></value>
  </Operation>

  <Operation Class="PatchOperationAddModExtension" MayRequire="VanillaExpanded.VARME"><success>Always</success>
          <xpath>Defs/ThingDef[defName="VAE_Handwear_PlateGloves" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
          <value><li Class="Contagion.ApparelContagionProtection"><handsSeal>0.4</handsSeal></li></value>
  </Operation>

