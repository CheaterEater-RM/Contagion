<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Authored disease-protection seals for known sealed apparel (design §6, docs/Apparel_Protection_Design.md).
       Resolution hierarchy rule 1: an ApparelContagionProtection modExtension is authoritative over the
       stat/tech-level fallback, and is DLC-independent (works without Odyssey's VacuumResistance).

       NOT authored here: masks (face mask, gas mask). Their airway protection is a FILTER read straight
       from ToxicEnvironmentResistance at runtime; authoring an airwaySeal would double-count it.

       Enclosed combat/space helmets set airwaySealed=true (sole airway protection, decision §2.1). Sealed
       suits set skinSeal high + coversExtremities (assumed gauntlets/boots, §9). Dedicated PPE (vacsuit +
       vac helmet) sets durableSeal=true so the seal holds to 0 HP; combat armor is incidental and degrades.

       Helmet airwaySeal is still authored alongside airwaySealed: airwaySealed grants full respiratory
       immunity, while airwaySeal remains the physical-filter value for non-respiratory vectors that happen
       to use the airway channel (for example plague proximity with airwayImmunityFactor=0).

       PatchOperationAddModExtension creates <modExtensions> if absent and appends to it if present, so this
       coexists with mods (e.g. Combat Extended) that add their own modExtension to the same def. -->

  <!-- ============================ Core ============================ -->

  <!-- Recon helmet -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetRecon"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.80</airwaySeal>
        <airwaySealed>true</airwaySealed>
      </li>
    </value>
  </Operation>

  <!-- Marine helmet -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Apparel_PowerArmorHelmet"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.85</airwaySeal>
        <airwaySealed>true</airwaySealed>
      </li>
    </value>
  </Operation>

  <!-- Recon armor -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorRecon"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>0.90</skinSeal>
        <coversExtremities>true</coversExtremities>
      </li>
    </value>
  </Operation>

  <!-- Marine (power) armor -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Apparel_PowerArmor"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>0.95</skinSeal>
        <coversExtremities>true</coversExtremities>
      </li>
    </value>
  </Operation>

  <!-- ============================ Royalty ============================ -->
  <!-- Cataphract helmet -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.royalty">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorHelmetCataphract"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.92</airwaySeal>
        <airwaySealed>true</airwaySealed>
      </li>
    </value>
  </Operation>

  <!-- Prestige marine helmet -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.royalty">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorMarineHelmetPrestige"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.85</airwaySeal>
        <airwaySealed>true</airwaySealed>
      </li>
    </value>
  </Operation>

  <!-- Cataphract armor -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.royalty">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorCataphract"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>1.00</skinSeal>
        <coversExtremities>true</coversExtremities>
      </li>
    </value>
  </Operation>

  <!-- Prestige marine armor -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.royalty">
    <xpath>Defs/ThingDef[defName="Apparel_ArmorMarinePrestige"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>0.95</skinSeal>
        <coversExtremities>true</coversExtremities>
      </li>
    </value>
  </Operation>

  <!-- ============================ Odyssey ============================ -->
  <!-- Vacsuit helmet (dedicated PPE: recycles oxygen, immune to tox gas) -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.odyssey">
    <xpath>Defs/ThingDef[defName="Apparel_VacsuitHelmet"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.85</airwaySeal>
        <airwaySealed>true</airwaySealed>
        <durableSeal>true</durableSeal>
      </li>
    </value>
  </Operation>

  <!-- Vacsuit (dedicated PPE: fully sealed body shell) -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.odyssey">
    <xpath>Defs/ThingDef[defName="Apparel_Vacsuit"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>1.00</skinSeal>
        <coversExtremities>true</coversExtremities>
        <durableSeal>true</durableSeal>
      </li>
    </value>
  </Operation>

  <!-- Kid vacsuit -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="ludeon.rimworld.odyssey">
    <xpath>Defs/ThingDef[defName="Apparel_VacsuitChildren"]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>1.00</skinSeal>
        <coversExtremities>true</coversExtremities>
        <durableSeal>true</durableSeal>
      </li>
    </value>
  </Operation>
</Patch>
