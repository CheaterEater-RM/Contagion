<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Inject Hediff_ContagionAnimalHiddenDisease as the hediffClass for each animal-variant
       disease def. This keeps the active disease invisible until a vet diagnoses it,
       enabling the sick-signal and passive-presentation mechanics. -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Animal_Plague" and not(hediffClass)]</xpath>
    <value>
      <hediffClass>Contagion.Hediff_ContagionAnimalHiddenDisease</hediffClass>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/HediffDef[defName="Animal_Plague"]/description</xpath>
    <value>
      <description>A flea-borne bacterial disease that can spread between humans and animals.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/HediffDef[defName="Animal_Flu"]/description</xpath>
    <value>
      <description>An influenza strain that infects non-human species.</description>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Animal_GutWorms" and not(hediffClass)]</xpath>
    <value>
      <hediffClass>Contagion.Hediff_ContagionAnimalHiddenDisease</hediffClass>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/HediffDef[defName="Animal_MuscleParasites" and not(hediffClass)]</xpath>
    <value>
      <hediffClass>Contagion.Hediff_ContagionAnimalHiddenDisease</hediffClass>
    </value>
  </Operation>
</Patch>
