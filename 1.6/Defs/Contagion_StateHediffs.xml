<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Contagion_Incubation</defName>
    <hediffClass>Contagion.Hediff_ContagionIncubation</hediffClass>
    <label>incubation</label>
    <description>Hidden incubation state used by Contagion before a disease becomes active.</description>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <HediffDef>
    <defName>Contagion_TemporaryImmunity</defName>
    <hediffClass>Contagion.Hediff_ContagionExpiry</hediffClass>
    <label>temporary immunity</label>
    <description>Hidden temporary immunity state used by Contagion to prevent immediate reinfection.</description>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <HediffDef>
    <defName>Contagion_TraitSeedCooldown</defName>
    <hediffClass>Contagion.Hediff_ContagionExpiry</hediffClass>
    <label>recovering</label>
    <description>Hidden per-pawn cooldown applied after a trait-driven disease seed (e.g. Sickly) to prevent back-to-back random illnesses on the same pawn.</description>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <HediffDef>
    <defName>Contagion_CorpseFleas</defName>
    <hediffClass>Contagion.Hediff_ContagionCorpseFleas</hediffClass>
    <label>fleas</label>
    <description>Hidden corpse state used by Contagion to track flea viability after death.</description>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>5.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- Visible signal that a handler noticed something wrong with an animal. A vet tends it to
       diagnose: reveals the underlying disease on success, or clears as false positive/negative. -->
  <HediffDef>
    <defName>Contagion_AnimalSick</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>sick</label>
    <description>This animal appears unwell. Have a veterinarian examine it.</description>
    <initialSeverity>0.05</initialSeverity>
    <isBad>true</isBad>
    <tendable>true</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <!-- Permanent after one treatment: vanilla's safety invariant that prevents TendPatient
           from looping if diagnosis code fails before the signal can be removed. -->
      <li Class="HediffCompProperties_TendDuration">
        <showTendQuality>false</showTendQuality>
      </li>
      <li Class="Contagion.HediffCompProperties_AnimalSickNaturalRecovery">
        <firstDayChance>0.20</firstDayChance>
        <chanceIncreasePerDay>0.10</chanceIncreasePerDay>
        <maxDays>5</maxDays>
      </li>
      <!-- Must remain last so vanilla marks the signal tended before diagnosis resolves it. -->
      <li Class="Contagion.HediffCompProperties_AnimalSickDiagnosis" />
    </comps>
  </HediffDef>

  <!-- Visible, self-clearing flag applied by the proactive right-click "Examine for illness".
       A vet tends it through the vanilla tend path (JobDriver_TendPatient), which fires the
       diagnosis via HediffComp_PendingExamDiagnosis. Modeled on Contagion_AnimalSick but labeled
       as an examination request (isBad false) so a healthy-looking animal isn't shown as sick.
       Guaranteed to clear: tended (comp removes it), auto-expires after a day (Disappears), or
       superseded if the animal becomes visibly sick (comp yields to Contagion_AnimalSick) — so an
       animal is never left silently flagged. -->
  <HediffDef>
    <defName>Contagion_PendingExam</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>flagged for examination</label>
    <description>A handler flagged this animal for a veterinary examination. A vet will examine it for hidden illness when it next rests. The flag clears once examined, or on its own after a day.</description>
    <initialSeverity>0.05</initialSeverity>
    <isBad>false</isBad>
    <tendable>true</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <!-- Anti-loop: vanilla marks the flag tended before diagnosis resolves it, so TendPatient
           won't re-loop. Mirrors Contagion_AnimalSick. -->
      <li Class="HediffCompProperties_TendDuration">
        <showTendQuality>false</showTendQuality>
      </li>
      <!-- Guaranteed removal if it is never tended (no doctor available, never rests). 1 game-day. -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>false</showRemainingTime>
      </li>
      <!-- Must remain last so vanilla marks the flag tended before diagnosis resolves it. -->
      <li Class="Contagion.HediffCompProperties_PendingExamDiagnosis" />
    </comps>
  </HediffDef>

  <!-- Per-animal cooldown applied after any examination (tending-path or proactive job).
       Prevents spamming exam attempts to statistically guarantee finding a hidden disease.
       Duration: 1 game-week (7 × 60,000 ticks). Uses the same timed-hediff class as the
       trait-seed cooldown but is scoped to animal diagnosis. -->
  <HediffDef>
    <defName>Contagion_AnimalDiagnosisCooldown</defName>
    <hediffClass>Contagion.Hediff_ContagionExpiry</hediffClass>
    <label>examined recently</label>
    <description>This animal was examined recently. It can be examined again after one week.</description>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

</Defs>
