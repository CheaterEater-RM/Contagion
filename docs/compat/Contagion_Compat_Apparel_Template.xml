<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  CONTAGION COMPATIBILITY TEMPLATE — APPAREL DISEASE PROTECTION
  ============================================================================

  Drop this file (renamed) into YOUR mod at:  YourMod/1.6/Patches/

  It attaches Contagion's `ApparelContagionProtection` modExtension to your
  apparel ThingDef(s) so worn gear protects pawns against disease vectors.
  No assembly reference, no Harmony, no C# required — pure XML.

  ────────────────────────────────────────────────────────────────────────────
  REQUIRED SETUP IN YOUR About/About.xml
  ────────────────────────────────────────────────────────────────────────────
    <loadAfter>
      <li>CheaterEater.Contagion</li>
    </loadAfter>

  Loading after Contagion guarantees your patch sees its defs and your
  modExtension is authoritative over Contagion's stat/tech-level fallback.

  ────────────────────────────────────────────────────────────────────────────
  RULES (these are why the template looks the way it does)
  ────────────────────────────────────────────────────────────────────────────
  1. Guard EVERY operation with MayRequire so the patch is silently skipped
     when Contagion is not installed:
        MayRequire="CheaterEater.Contagion,your.mod.id"
     (Comma-separated: Contagion + the mod that owns the apparel def. If the
      apparel is your own, list only your own id alongside Contagion.)

  2. Use PatchOperationAddModExtension to attach the <li>. It creates the
     <modExtensions> node if the def has none and appends to it if one already
     exists — e.g. another mod (like Combat Extended) added its own modExtension
     to the same def first. One operation is enough; do NOT use the older
     two-step "create <modExtensions> if absent, then add the <li>" pattern —
     its first step uses not(modExtensions), which silently fails to match (and
     logs an error) the moment any other mod has already added a modExtension.
     Keep the li-guard not(modExtensions/li[@Class="..."]) in the xpath so the
     operation is idempotent and never adds the extension twice.
     NEVER use PatchOperationSequence/PatchOperationConditional against a
     <modExtensions> node that may be absent — it half-applies and corrupts
     the def database.

  3. <success>Always</success> keeps the operation quiet (no red error) when
     its xpath matches nothing — e.g. the def already carries the extension
     (idempotent re-run), or the target def is absent in this load order.

  ────────────────────────────────────────────────────────────────────────────
  ApparelContagionProtection FIELDS  (all optional; omit what you don't need)
  ────────────────────────────────────────────────────────────────────────────
    airwaySeal   float 0..1   Airway channel seal quality (0 porous, 1 hermetic).
    skinSeal     float 0..1   Torso/skin channel seal quality.
    handsSeal    float 0..1   Hands channel seal quality.
    feetSeal     float 0..1   Feet channel seal quality.
        Body-part COVERAGE is automatic from the apparel's bodyPartGroups;
        these values set how well the covered area SEALS.

    airwaySealed          bool  Enclosed helmet: airway hermetically sealed ->
                                full respiratory-vector immunity, regardless of
                                filter math. Set on combat/space helmets.
    coversExtremities     bool  Credit hands/feet at this item's skinSeal when
                                vanilla coverage omits them but the suit clearly
                                includes gauntlets/boots. Disease-calc only;
                                never affects ArmorRating / combat coverage.
    durableSeal           bool  Dedicated PPE: seal holds to 0 HP, exempt from
                                ratty/tattered seal-integrity degradation.
    providesSealedAtmosphere bool  This single item is a fully sealed suit
                                (modded hazmat) -> trips the sealed-system
                                capstone on any DLC.

  ────────────────────────────────────────────────────────────────────────────
  IMPORTANT — MASKS
  ────────────────────────────────────────────────────────────────────────────
  A plain mask's airway filtering is read at RUNTIME from its
  ToxicEnvironmentResistance stat. Do NOT author airwaySeal on such a mask —
  it double-counts the protection. Only author airwaySeal for a mask whose mod
  gives it the WRONG stat (ToxicResistance instead of ToxicEnvironmentResistance);
  in that case set a graded airwaySeal WITHOUT airwaySealed so it filters but
  is not treated as hermetic.

  ────────────────────────────────────────────────────────────────────────────
  Replace YourModId and the defNames below, delete the examples you don't need.
  ============================================================================
-->
<Patch>

  <!-- ======================================================================
       EXAMPLE 1 — Full hazmat suit (sealed body shell, dedicated PPE)
       ====================================================================== -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="CheaterEater.Contagion,YourModId">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="YourHazmatSuit" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <skinSeal>1.00</skinSeal>
        <coversExtremities>true</coversExtremities>
        <providesSealedAtmosphere>true</providesSealedAtmosphere>
        <durableSeal>true</durableSeal>
      </li>
    </value>
  </Operation>

  <!-- ======================================================================
       EXAMPLE 2 — Enclosed helmet (sole airway protection)
       airwaySealed grants full respiratory immunity; airwaySeal stays as the
       physical-filter value for non-respiratory vectors that use the airway.
       ====================================================================== -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="CheaterEater.Contagion,YourModId">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="YourSealedHelmet" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.85</airwaySeal>
        <airwaySealed>true</airwaySealed>
      </li>
    </value>
  </Operation>

  <!-- ======================================================================
       EXAMPLE 3 — Gloves (hands channel only)
       The single most useful piece of PPE for fomite / butchery / cooking
       vectors. Coverage is automatic from bodyPartGroups (Hands).
       ====================================================================== -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="CheaterEater.Contagion,YourModId">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="YourGloves" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <handsSeal>0.90</handsSeal>
      </li>
    </value>
  </Operation>

  <!-- ======================================================================
       EXAMPLE 4 — Mask with the WRONG stat (filter, not hermetic)
       ONLY do this when the mask's mod sets ToxicResistance instead of
       ToxicEnvironmentResistance, so Contagion's runtime filter sees nothing.
       Author a graded airwaySeal but DO NOT set airwaySealed.
       ====================================================================== -->
  <Operation Class="PatchOperationAddModExtension" MayRequire="CheaterEater.Contagion,YourModId">
    <success>Always</success>
    <xpath>Defs/ThingDef[defName="YourMaskWithWrongStat" and not(modExtensions/li[@Class="Contagion.ApparelContagionProtection"])]</xpath>
    <value>
      <li Class="Contagion.ApparelContagionProtection">
        <airwaySeal>0.80</airwaySeal>
      </li>
    </value>
  </Operation>

</Patch>
